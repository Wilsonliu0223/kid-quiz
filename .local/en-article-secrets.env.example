# 複製此檔為 en-article-secrets.env 後填入（勿提交 git）
# cp en-article-secrets.env.example en-article-secrets.env

# 與 js/config.site.js 的 SCORE_LOG_URL 相同（Apps Script 網頁應用程式 /exec）
SCORE_LOG_URL=https://script.google.com/macros/s/XXXX/exec

# 與 Apps Script「指令碼屬性」EN_ARTICLE_WRITE_TOKEN 相同
EN_ARTICLE_WRITE_TOKEN=請改成一串只有你知道的密碼
